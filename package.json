{
  "name": "nexlink",
  "version": "0.1.3",
  "license": "GPL-3.0",
  "author": "hu-1029",
  "type": "module",
  "description": "新一代现代化 Windows 代理客户端——融合 Clash Verge Rev 现代 UI + v2rayN 全格式自由导入体验",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/update-mihomo-hash.js",
    "build": "tsc -b && vite build",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.nexlink.app",
    "productName": "NexLink",
    "copyright": "Copyright © 2026 hu-1029",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "resources/icons/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NexLink",
      "installerIcon": "resources/icons/app-icon.ico",
      "uninstallerIcon": "resources/icons/app-icon.ico",
      "installerHeaderIcon": "resources/icons/app-icon.ico",
      "artifactName": "Windows-${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Windows-${productName}-Portable.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "yaml": "^2.9.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
